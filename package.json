{
  "name": "@digisquares/datasquares-embed-react",
  "version": "0.2.1",
  "description": "React SDK for embedding DataSquares dashboards, reports and presentations: the <DataSquaresEmbed> component, typed events, host-side controls (params, pages, refresh), and a server-side signer for each person's short-lived embed token.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digisquares/datasquares-embed-react.git"
  },
  "keywords": [
    "datasquares",
    "embed",
    "embedded-analytics",
    "dashboard",
    "react"
  ]
}
